{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Previously reviewed read-only Fastboot query plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serial",
    "baseline",
    "queries"
  ],
  "properties": {
    "serial": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "baseline": {
      "type": "object",
      "minProperties": 4,
      "required": [
        "product",
        "version-bootloader",
        "device-state",
        "secureboot"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "expected"
        ],
        "properties": {
          "key": {
            "enum": [
              "product",
              "version-bootloader",
              "device-state",
              "secureboot",
              "boot-state",
              "unlocked",
              "secure",
              "max-download-size"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
